<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:TaskMGR.UI.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="TaskMGR.UI.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Task Manager" Width="1000" Height="700"
        MinWidth="800" MinHeight="500">
    
    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>
    
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Header with system metrics -->
        <Border Grid.Row="0" Background="#1a1a2e" Padding="16">
            <Grid ColumnDefinitions="*,*,*,*">
                <!-- CPU -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <TextBlock Text="CPU" FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SystemMetrics.CpuUsagePercent, StringFormat={}{0:F1}%}" 
                               FontSize="28" FontWeight="Bold" Foreground="#4cc9f0" HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Memory -->
                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                    <TextBlock Text="Memory" FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding MemoryUsageText}" 
                               FontSize="20" FontWeight="Bold" Foreground="#f72585" HorizontalAlignment="Center"/>
                    <ProgressBar Value="{Binding MemoryUsagePercent}" Maximum="100" 
                                 Height="4" Width="120" Margin="0,4,0,0"
                                 Foreground="#f72585"/>
                </StackPanel>
                
                <!-- Processes -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <TextBlock Text="Processes" FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding SystemMetrics.ProcessCount}" 
                               FontSize="28" FontWeight="Bold" Foreground="#7209b7" HorizontalAlignment="Center"/>
                </StackPanel>
                
                <!-- Uptime -->
                <StackPanel Grid.Column="3" HorizontalAlignment="Center">
                    <TextBlock Text="Uptime" FontSize="12" Foreground="#888" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding UptimeText}" 
                               FontSize="20" FontWeight="Bold" Foreground="#3a0ca3" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Toolbar -->
        <Border Grid.Row="1" Background="#16213e" Padding="12">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <TextBox Grid.Column="0" Width="250" Watermark="Search processes..."
                         Text="{Binding SearchText}" Margin="0,0,12,0"/>
                
                <TextBlock Grid.Column="1" Text="{Binding PlatformName, StringFormat=Platform: {0}}" 
                           VerticalAlignment="Center" Foreground="#888"/>
                
                <Button Grid.Column="2" Content="⟳ Refresh" Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding !IsLoading}" Margin="0,0,8,0"
                        Background="#4361ee" Foreground="White" Padding="12,8"/>
                
                <Button Grid.Column="3" Content="✕ End Task" Command="{Binding KillProcessCommand}"
                        IsEnabled="{Binding SelectedProcess, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Background="#e63946" Foreground="White" Padding="12,8"/>
            </Grid>
        </Border>
        
        <!-- Process list -->
        <DataGrid Grid.Row="2" ItemsSource="{Binding Processes}" 
                  SelectedItem="{Binding SelectedProcess}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  GridLinesVisibility="Horizontal" 
                  Background="#0f0f23" Foreground="White"
                  RowBackground="#0f0f23">
            <DataGrid.Columns>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="CPU %" Binding="{Binding CpuPercent, StringFormat={}{0:F1}}" Width="80"/>
                <DataGridTextColumn Header="Memory" Binding="{Binding MemoryBytes, Converter={StaticResource BytesToStringConverter}}" Width="100"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="User" Binding="{Binding User}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
        
        <!-- Status bar -->
        <Border Grid.Row="3" Background="#16213e" Padding="8,4">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#888" FontSize="12"/>
        </Border>
    </Grid>
</Window>
